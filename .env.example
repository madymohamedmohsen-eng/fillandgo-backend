# Fill & Go — Environment Variables
# Copy this to .env and fill in your values

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — used for LOCAL development.
# In production (Render/Railway/etc.) set DATABASE_URL instead and this block is ignored.
DB_NAME=fillandgo_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Production database (provided automatically by Render/Railway/Heroku-style hosts)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Redis (for Celery task queue) — optional, only needed for scheduled reminder notifications
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated, only needed in production)
CORS_ALLOWED_ORIGINS=https://yourfrontend.com

# CSRF (comma-separated, needed for /admin/ in production, e.g. https://fillandgo-api.onrender.com)
CSRF_TRUSTED_ORIGINS=

